<% page_title "Opposers of #{@priority.name}" %>
<div class="panel">
  <h1>Opposers</h1>
  <p class="muted"><%= link_to @priority.name, @priority %></p>
  <% if @users.any? %>
    <div class="people-grid">
      <% @users.each do |u| %>
        <div class="person-card"><%= avatar u %><div><div class="pname"><%= link_to u.name, user_path(u) %></div></div></div>
      <% end %>
    </div>
  <% else %><p class="empty">No opposers yet.</p><% end %>
</div>
