<% page_title "Priorities" %>
<% tab = @tab || "top" %>

<div class="layout-split">
  <div>
    <% unless logged_in? %>
      <div class="hero">
        <h1><%= gov.name %></h1>
        <p><%= gov.tagline %></p>
        <div class="prompt">
          <%= link_to "Join the debate →", signup_path, class: "btn btn-primary" %>
          <%= link_to "Add a priority", new_priority_path, class: "btn btn-ghost", style: "color:#fff;border-color:rgba(255,255,255,.4)" %>
        </div>
      </div>
    <% else %>
      <h1>Priorities</h1>
      <p class="muted"><%= gov.prompt %></p>
    <% end %>

    <nav class="tabs">
      <%= link_to "Top", top_priorities_path, class: ("active" if tab == "top") %>
      <%= link_to "Rising", rising_priorities_path, class: ("active" if tab == "rising") %>
      <%= link_to "Falling", falling_priorities_path, class: ("active" if tab == "falling") %>
      <%= link_to "Controversial", controversial_priorities_path, class: ("active" if tab == "controversial") %>
      <%= link_to "Newest", newest_priorities_path, class: ("active" if tab == "newest") %>
      <%= link_to "Finished", finished_priorities_path, class: ("active" if tab == "finished") %>
      <% if logged_in? %><%= link_to "Yours", yours_priorities_path, class: ("active" if tab == "yours") %><% end %>
    </nav>

    <div class="panel">
      <% if @priorities.any? %>
        <% @priorities.each_with_index do |priority, i| %>
          <%= render "priorities/priority", priority: priority %>
        <% end %>
        <%= pager(@priorities) %>
      <% else %>
        <div class="empty">
          <p>No priorities here yet.</p>
          <%= link_to "Add the first one", new_priority_path, class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>

  <aside>
    <div class="panel">
      <h3>Add a priority</h3>
      <p class="muted small">What do you think the government should do?</p>
      <%= link_to "Add a priority", new_priority_path, class: "btn btn-primary", style: "width:100%" %>
    </div>

    <% if gov.tags? %>
      <div class="panel">
        <h3><%= gov.tags_name.pluralize %></h3>
        <div class="tag-cloud">
          <% Tag.where("priorities_count > 0").popular.limit(20).each do |t| %>
            <%= link_to t.display_title, tag_path(t), title: pluralize(t.priorities_count, "priority") %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="panel">
      <h3>Recent activity</h3>
      <% Activity.feed.includes(:user).limit(6).each do |a| %>
        <div class="feed-item" style="padding:8px 0">
          <div class="feed-icon"><%= a.icon %></div>
          <div class="feed-body small">
            <% if a.user %><%= link_to a.user.name, user_path(a.user) %><% else %>Someone<% end %>
            <%= a.sentence %>
            <% if a.priority %><%= link_to truncate(a.priority.name, length: 40), a.priority %><% end %>
            <div class="ftime"><%= relative_time a.created_at %></div>
          </div>
        </div>
      <% end %>
      <p class="small"><%= link_to "See all activity →", feed_path %></p>
    </div>
  </aside>
</div>
