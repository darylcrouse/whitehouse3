<% page_title @priority.name %>

<div class="layout-split">
  <div>
    <div class="panel">
      <div style="display:flex; gap:16px; align-items:flex-start">
        <div class="rank" style="font-size:2rem">#<%= @priority.position.positive? ? @priority.position : "–" %></div>
        <div style="flex:1">
          <h1><%= @priority.name %></h1>
          <div class="statline">
            <span><b><%= @priority.up_endorsements_count %></b> endorse</span>
            <span><b><%= @priority.down_endorsements_count %></b> oppose</span>
            <span><b><%= @priority.points_count %></b> points</span>
            <span><b><%= @priority.documents_count %></b> documents</span>
            <% if @priority.user %><span>by <%= link_to @priority.user.name, user_path(@priority.user) %></span><% end %>
          </div>
          <% if @priority.finished? %>
            <p><span class="badge badge-official"><%= @priority.official_status_name %></span></p>
          <% end %>
          <% if @priority.issue_list.any? %>
            <div class="tag-cloud">
              <% @priority.issue_list.each do |t| %><%= link_to t, tag_path(t.parameterize) %><% end %>
            </div>
          <% end %>
        </div>
        <%= render "priorities/endorse_buttons", priority: @priority %>
      </div>

      <% if logged_in? && (current_user.admin? || current_user.id == @priority.user_id) %>
        <p class="small" style="margin-top:12px">
          <%= link_to "Edit", edit_priority_path(@priority) %> ·
          <%= link_to "Propose a change", new_priority_change_path(@priority) %> ·
          <%= button_to "Delete", priority_path(@priority), method: :delete, class: "linkish", style: "color:var(--down)", data: { turbo_confirm: "Delete this priority?" } %>
        </p>
      <% end %>
    </div>

    <div class="panel" id="points">
      <h2>Points</h2>
      <p class="muted small">Short arguments for and against this priority. <%= link_to "Add a point", new_priority_point_path(@priority) if logged_in? %></p>
      <div class="two-col">
        <div>
          <div class="col-head support">Supports (<%= @priority.up_points_count %>)</div>
          <% if @points_for.any? %>
            <% @points_for.each do |point| %><%= render "points/point", point: point %><% end %>
          <% else %><p class="muted small">No supporting points yet.</p><% end %>
          <% if logged_in? %><%= link_to "+ Add a supporting point", new_priority_point_path(@priority, value: 1), class: "small" %><% end %>
        </div>
        <div>
          <div class="col-head oppose">Opposes (<%= @priority.down_points_count %>)</div>
          <% if @points_against.any? %>
            <% @points_against.each do |point| %><%= render "points/point", point: point %><% end %>
          <% else %><p class="muted small">No opposing points yet.</p><% end %>
          <% if logged_in? %><%= link_to "+ Add an opposing point", new_priority_point_path(@priority, value: -1), class: "small" %><% end %>
        </div>
      </div>
    </div>

    <div class="panel">
      <h2>Documents</h2>
      <% if @documents.any? %>
        <ul class="item-list">
          <% @documents.each do |doc| %>
            <li class="argument <%= doc.supporting? ? 'support' : (doc.opposing? ? 'oppose' : '') %>">
              <div class="ahead"><%= link_to doc.name, priority_document_path(@priority, doc) %></div>
              <div class="ameta"><%= doc.side_name %> · by <%= doc.user&.name || "someone" %> · <%= relative_time doc.created_at %></div>
            </li>
          <% end %>
        </ul>
      <% else %><p class="muted small">No documents yet.</p><% end %>
      <% if logged_in? %><%= link_to "Write a document", new_priority_document_path(@priority), class: "btn btn-sm" %><% end %>
    </div>

    <div class="panel">
      <h2>Discussion</h2>
      <% if @activities.any? %>
        <% @activities.each do |a| %><%= render "activities/activity", activity: a %><% end %>
      <% else %><p class="muted small">No activity yet.</p><% end %>
    </div>
  </div>

  <aside>
    <div class="panel">
      <h3>Endorsers</h3>
      <p class="small"><%= link_to "#{@priority.up_endorsements_count} endorse", endorsers_priority_path(@priority) %> ·
        <%= link_to "#{@priority.down_endorsements_count} oppose", opposers_priority_path(@priority) %></p>
    </div>
    <% if @related.any? %>
      <div class="panel">
        <h3>Related priorities</h3>
        <ul class="item-list">
          <% @related.each do |p| %>
            <li style="padding:6px 0"><%= link_to p.name, p %><div class="small muted"><%= pluralize p.endorsements_count, "endorser" %></div></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </aside>
</div>
