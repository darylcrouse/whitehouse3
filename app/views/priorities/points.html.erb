<% page_title "Points · #{@priority.name}" %>
<div class="panel">
  <h1>Points</h1>
  <p class="muted"><%= link_to @priority.name, @priority %></p>
  <% if @points.any? %>
    <% @points.each do |point| %><%= render "points/point", point: point %><% end %>
    <%= pager(@points) %>
  <% else %><p class="empty">No points yet.</p><% end %>
</div>
