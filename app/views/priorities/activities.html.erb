<% page_title "Activity · #{@priority.name}" %>
<div class="panel">
  <h1>Activity</h1>
  <p class="muted"><%= link_to @priority.name, @priority %></p>
  <% if @activities.any? %>
    <% @activities.each do |a| %><%= render "activities/activity", activity: a %><% end %>
    <%= pager(@activities) %>
  <% else %><p class="empty">No activity yet.</p><% end %>
</div>
