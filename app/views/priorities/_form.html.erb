<% if params[:q] %>
	<p><%= t('priorities.new.suggest') %>
<% end %>
<%# NOTE: a <form> may not wrap table rows (the HTML parser foster-parents it
    and ejects its contents, breaking both styling and submission). Use a
    flex row instead. %>
<%= form_for(Priority.new) do |f| %>
<% if @tag_names %>
	<%= hidden_field_tag :tag_names, @tag_names %>
<% end %>
<div class="wh3-priority-form">
	<%= f.text_field :name, :size => 40, :maxlength => 60, :autocomplete => "off" %>
	<%= f.submit t('priorities.new.submit'), :class => "suggest_button" %>
</div>
<% end %>
