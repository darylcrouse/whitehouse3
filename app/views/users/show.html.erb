<% page_title @user.name %>
<div class="layout-split">
  <div>
    <div class="panel">
      <div style="display:flex; gap:16px; align-items:center">
        <%= avatar @user, 72 %>
        <div style="flex:1">
          <h1 style="margin-bottom:2px"><%= @user.name %></h1>
          <div class="muted">@<%= @user.login %><% if @user.official? %> · <span class="badge badge-official">Official</span><% end %></div>
          <div class="statline" style="margin-top:8px">
            <span><b><%= @user.endorsements_count %></b> priorities</span>
            <span><b><%= @user.points_count %></b> points</span>
            <span><b><%= @user.followers_count %></b> followers</span>
          </div>
        </div>
        <% if logged_in? && current_user.id != @user.id %>
          <% if current_user.following?(@user) %>
            <%= button_to "Following ✓", unfollow_user_path(@user), class: "btn btn-sm btn-primary" %>
          <% else %>
            <%= button_to "Follow", follow_user_path(@user), class: "btn btn-sm" %>
          <% end %>
          <%= link_to "Message", new_message_path(to: @user.id), class: "btn btn-sm" %>
        <% end %>
      </div>
      <% if @user.bio.present? %><p style="margin-top:12px"><%= simple_format @user.bio %></p><% end %>
      <% if @user.website.present? %><p class="small"><a href="<%= @user.website %>" rel="nofollow noopener"><%= @user.website %></a></p><% end %>
    </div>

    <div class="panel">
      <h2>Top priorities</h2>
      <% if @priorities.any? %>
        <ol style="padding-left:20px">
          <% @priorities.each do |p| %>
            <li style="margin-bottom:6px"><%= link_to p.name, p %>
              <%= endorsement_badge(@user, p) %></li>
          <% end %>
        </ol>
        <p class="small"><%= link_to "All #{@user.name}'s priorities →", priorities_user_path(@user) %></p>
      <% else %><p class="muted small">No priorities yet.</p><% end %>
    </div>

    <div class="panel">
      <h2>Recent activity</h2>
      <% if @activities.any? %>
        <% @activities.each do |a| %><%= render "activities/activity", activity: a %><% end %>
      <% else %><p class="muted small">No activity yet.</p><% end %>
    </div>
  </div>

  <aside>
    <div class="panel">
      <h3>On the record</h3>
      <p class="small"><b><%= @user.up_endorsements_count %></b> endorsed · <b><%= @user.down_endorsements_count %></b> opposed</p>
      <p class="small"><%= link_to "Points", points_user_path(@user) %> · <%= link_to "Activity", activities_user_path(@user) %></p>
    </div>
  </aside>
</div>
