<% page_title "#{@user.name}'s activity" %>
<div class="panel">
  <h1><%= @user.name %>'s activity</h1>
  <% if @activities.any? %>
    <% @activities.each do |a| %><%= render "activities/activity", activity: a %><% end %>
    <%= pager(@activities) %>
  <% else %><p class="empty">No activity yet.</p><% end %>
</div>
