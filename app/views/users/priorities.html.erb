<% page_title "#{@user.name}'s priorities" %>
<div class="panel">
  <h1><%= @user.name %>'s priorities</h1>
  <% if @priorities.any? %>
    <% @priorities.each do |p| %><%= render "priorities/priority", priority: p %><% end %>
    <%= pager(@priorities) %>
  <% else %><p class="empty">No priorities yet.</p><% end %>
</div>
