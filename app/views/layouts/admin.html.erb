<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Admin · <%= Government.current.name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="<%= admin_root_path %>" class="brand"><span class="brand-mark">★</span> Admin</a>
        <nav class="main-nav"></nav>
        <div class="account-nav">
          <%= link_to "← Back to site", root_path %>
          <%= link_to current_user.name, user_path(current_user) %>
        </div>
      </div>
    </header>
    <% if notice %><div class="flash flash-notice container"><%= notice %></div><% end %>
    <% if alert %><div class="flash flash-alert container"><%= alert %></div><% end %>
    <main class="container main-content">
      <div class="admin-shell">
        <nav class="admin-nav panel">
          <%= link_to "Dashboard", admin_root_path %>
          <%= link_to "Priorities", admin_priorities_path %>
          <%= link_to "Users", admin_users_path %>
          <%= link_to "Pages", admin_pages_path %>
          <%= link_to "Blurbs", admin_blurbs_path %>
          <%= link_to "Site settings", edit_admin_government_path %>
        </nav>
        <div><%= yield %></div>
      </div>
    </main>
  </body>
</html>
