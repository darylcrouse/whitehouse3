<% page_title @point.name %>
<div class="layout-split">
  <div class="panel">
    <div class="badge <%= @point.supporting? ? 'badge-up' : (@point.opposing? ? 'badge-down' : '') %>"><%= @point.side_name %></div>
    <h1><%= @point.name %></h1>
    <p class="muted small">On <%= link_to @priority.name, @priority %> · by <%= @point.user&.name || "someone" %> · <%= relative_time @point.created_at %></p>
    <div><%= simple_format @point.content %></div>
    <% if @point.website.present? %><p><a href="<%= @point.website %>" rel="nofollow noopener"><%= @point.website %></a></p><% end %>
    <p>
      <span class="count-up">▲ <%= @point.helpful_count %> helpful</span>
      <span class="count-down"><%= @point.unhelpful_count %> not helpful ▼</span>
    </p>
    <% if logged_in? %>
      <%= button_to "Helpful", quality_point_path(@point), class: "btn btn-up btn-sm" %>
      <%= button_to "Not helpful", unquality_point_path(@point), class: "btn btn-down btn-sm" %>
      <% if current_user.admin? || current_user.id == @point.user_id %>
        <%= link_to "Edit", edit_priority_point_path(@priority, @point), class: "btn btn-sm" %>
      <% end %>
    <% end %>
  </div>
  <aside>
    <div class="panel">
      <h3>Priority</h3>
      <p><%= link_to @priority.name, @priority %></p>
      <%= render "priorities/endorse_buttons", priority: @priority %>
    </div>
  </aside>
</div>
