<%= form_with model: [:admin, @page] do |f| %>
  <% if @page.errors.any? %>
    <div class="errors"><ul><% @page.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
  <% end %>
  <div class="form-field"><%= f.label :name %><%= f.text_field :name, autofocus: true %></div>
  <div class="form-field"><%= f.label :short_name, "URL slug" %><%= f.text_field :short_name %><div class="hint">Leave blank to auto-generate.</div></div>
  <div class="form-field"><%= f.label :link_name, "Footer link label (optional)" %><%= f.text_field :link_name %></div>
  <div class="form-field"><%= f.label :content %><%= f.text_area :content, style: "min-height:240px" %></div>
  <div class="form-actions">
    <%= f.submit "Save page", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_pages_path, class: "btn btn-ghost" %>
  </div>
<% end %>
