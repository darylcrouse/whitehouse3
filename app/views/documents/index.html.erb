<% page_title "Documents" %>
<div class="panel">
  <h1>Documents</h1>
  <% if @documents.any? %>
    <ul class="item-list">
      <% @documents.each do |doc| %>
        <li class="argument <%= doc.supporting? ? 'support' : (doc.opposing? ? 'oppose' : '') %>">
          <div class="ahead"><%= link_to doc.name, priority_document_path(doc.priority, doc) %></div>
          <div class="ameta">on <%= link_to doc.priority.name, doc.priority %> · by <%= doc.user&.name || "someone" %> · <%= relative_time doc.created_at %></div>
        </li>
      <% end %>
    </ul>
    <%= pager(@documents) %>
  <% else %><p class="empty">No documents yet.</p><% end %>
</div>
