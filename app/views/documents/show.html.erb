<% page_title @document.name %>
<div class="layout-split">
  <article class="panel">
    <div class="badge <%= @document.supporting? ? 'badge-up' : (@document.opposing? ? 'badge-down' : '') %>"><%= @document.side_name %></div>
    <h1><%= @document.name %></h1>
    <p class="muted small">On <%= link_to @priority.name, @priority %> · by <%= @document.user&.name || "someone" %> · <%= relative_time @document.created_at %></p>
    <div><%= simple_format @document.content %></div>
    <% if logged_in? && (current_user.admin? || current_user.id == @document.user_id) %>
      <p class="small"><%= link_to "Edit", edit_priority_document_path(@priority, @document) %></p>
    <% end %>
  </article>
  <aside>
    <div class="panel">
      <h3>Priority</h3>
      <p><%= link_to @priority.name, @priority %></p>
      <%= render "priorities/endorse_buttons", priority: @priority %>
    </div>
  </aside>
</div>
