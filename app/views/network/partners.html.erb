<div id="hp_intro"><%= @page_title %></div>
<p>
<%= t('partners.intro')%>	
<p>

<table border="0" cellspacing="0" cellpadding="0">
	
	<% @partners.in_groups_of(4,false) do |row_partners| %>
		<tr>
		<% for partner in row_partners %>
			<td valign="middle" align="center">
			<div class="partner_logo">
				<% if partner.logo.attached? %>
					<% if partner.has_website? %>
						<a href="<%= partner.website_link %>"><%= image_tag url_for(partner.logo), :border => 0 %></a>
					<% else %>
						<%= image_tag url_for(partner.logo), :border => 0 %>
					<% end %>
				<% end %>
			</div>
			</td>
		<% end %>
		</tr>
	<% end %>
	
</table>

