<% page_title @branch.name %>
<div class="layout-split">
  <div class="panel">
    <h1><%= @branch.name %></h1>
    <% if @branch.description.present? %><p class="muted"><%= @branch.description %></p><% end %>
    <h2>Top priorities in this branch</h2>
    <% if @priorities.any? %>
      <% @priorities.each do |p| %><%= render "priorities/priority", priority: p %><% end %>
    <% else %><p class="muted small">No priorities endorsed by branch members yet.</p><% end %>
  </div>
  <aside>
    <div class="panel">
      <h3>Members</h3>
      <% @members.each do |u| %>
        <div class="person-card" style="margin-bottom:8px"><%= avatar u, 32 %><div class="pname"><%= link_to u.name, user_path(u) %></div></div>
      <% end %>
      <% if @members.empty? %><p class="muted small">No members yet.</p><% end %>
    </div>
  </aside>
</div>
