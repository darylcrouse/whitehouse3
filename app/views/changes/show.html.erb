<% page_title "Proposed change" %>
<div class="panel" style="max-width:640px;margin:0 auto">
  <h1>Proposed change</h1>
  <p class="muted">To <%= link_to @priority.name, @priority %> · status: <strong><%= @change.status %></strong></p>
  <div><%= simple_format @change.content %></div>
  <div class="statline">
    <span class="count-up">▲ <%= @change.yes_votes %> yes</span>
    <span class="count-down"><%= @change.no_votes %> no ▼</span>
    <span><%= pluralize @change.votes_count, "vote" %></span>
  </div>
  <% if logged_in? && @change.open? %>
    <div class="form-actions">
      <%= button_to "Vote yes", priority_change_votes_path(@priority, @change, value: 1), class: "btn btn-up btn-sm" %>
      <%= button_to "Vote no", priority_change_votes_path(@priority, @change, value: -1), class: "btn btn-down btn-sm" %>
    </div>
    <% if current_user.admin? %>
      <div class="form-actions">
        <%= button_to "Approve", approve_priority_change_path(@priority, @change), method: :put, class: "btn btn-sm" %>
        <%= button_to "Decline", decline_priority_change_path(@priority, @change), method: :put, class: "btn btn-sm btn-ghost" %>
      </div>
    <% end %>
  <% end %>
  <p class="small"><%= link_to "All changes", priority_changes_path(@priority) %></p>
</div>
