<% page_title "Propose a change" %>
<div class="panel" style="max-width:560px;margin:0 auto">
  <h1>Propose a change</h1>
  <p class="muted">To <%= link_to @priority.name, @priority %></p>
  <%= form_with model: [@priority, @change] do |f| %>
    <% if @change.errors.any? %>
      <div class="errors"><ul><% @change.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
    <% end %>
    <div class="form-field">
      <%= f.label :type, "Kind of change" %>
      <%= f.select :type, [["Reword the priority", "ChangeName"], ["Merge with another", "ChangeMerge"], ["Other", "ChangeOther"]] %>
    </div>
    <div class="form-field"><%= f.label :content, "Describe the change" %><%= f.text_area :content, autofocus: true %></div>
    <div class="form-actions">
      <%= f.submit "Propose change", class: "btn btn-primary" %>
      <%= link_to "Cancel", @priority, class: "btn btn-ghost" %>
    </div>
  <% end %>
</div>
